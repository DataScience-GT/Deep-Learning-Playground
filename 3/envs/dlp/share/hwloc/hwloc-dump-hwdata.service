[Unit]
Description=Dump hardware topology and locality information to /home/runner/work/Deep-Learning-Playground/Deep-Learning-Playground/3/envs/dlp/var/run/hwloc

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/runner/work/Deep-Learning-Playground/Deep-Learning-Playground/3/envs/dlp/sbin/hwloc-dump-hwdata -o /home/runner/work/Deep-Learning-Playground/Deep-Learning-Playground/3/envs/dlp/var/run/hwloc

[Install]
