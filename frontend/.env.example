# Frontend env vars used by this repo. Copy to frontend/.env and fill in values
# from club AWS Secrets Manager (secret name: frontend_env) or a project lead.
# Do not commit real values. frontend/.env is gitignored.

# Written by backend/aws_helpers/aws_secrets_utils/build_env.py from AWS secret "frontend_env"
REACT_APP_SECRET_KEY=
REACT_APP_CAPTCHA_SITE_KEY=
REACT_APP_FEEDBACK_EMAIL=

# Read by frontend/src/features/OpenAi/openAiUtils.ts
NEXT_PUBLIC_OPEN_AI_API_KEY_DLP002=

# When set to "production", frontend/next.config.js rewrites /api/training to the
# AWS ALB URL instead of http://127.0.0.1:8000. Leave unset for local development.
ENVIRONMENT=
